# Cloudflare Radar API (required for traffic data)
# Create token: dash.cloudflare.com → My Profile → API Tokens → "Cloudflare Radar: Read"
CLOUDFLARE_API_TOKEN=

# MongoDB
MONGO_URI=
# OpenAI (for AI-generated notes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Slack Bot (for sending notes to channel)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Public v1 API (/api/v1/*) — comma-separated list of label:key pairs.
# The label only shows up in logs and rate-limit buckets; the key is the secret.
# Generate one with: openssl rand -hex 24
# PUBLIC_API_KEYS=partner-name:mic_live_xxxxxxxx,another:mic_live_yyyyyyyy
PUBLIC_API_KEYS=
# Requests per minute allowed per key (default 120)
PUBLIC_API_RATE_LIMIT=120

# App
NODE_ENV=production
API_PORT=3000
ETL_PORT=4000
